# Copy to 00_secrets.env (gitignored) and fill in real values before running
# 01_render-and-deploy.sh. These are the ${VAR} placeholders referenced in
# flink-jobs/inventory-monitor/*.sql, 00_serviceaccount.yaml and
# 02_flinkdeployment.yaml.
#
# EVENTHUBS_*, ADLS_ACCOUNT_*, FLINK_WORKLOAD_IDENTITY_CLIENT_ID come from
# `terraform output` in terraform/env/dev. POLARIS_CLIENT_ID/
# POLARIS_CLIENT_SECRET are the credentials of the flink_app principal
# printed by scripts/setup-polaris.sh -- not the bootstrap root
# credentials in k8s/polaris/02_secret.yaml.
#
# ADLS_ACCOUNT_KEY is still needed here: Iceberg reads/writes go through
# Workload Identity now (see 01_catalog.sql), but Flink's own checkpoint/HA
# storage (02_flinkdeployment.yaml) still authenticates with the key --
# the bundled Hadoop-Azure driver is too old to have
# WorkloadIdentityTokenProvider. See that file's comment for the detail.
EVENTHUBS_BOOTSTRAP_SERVERS=evh-realtime-lakehouse-dev.servicebus.windows.net:9093
EVENTHUBS_CONNECTION_STRING=x
ADLS_ACCOUNT_NAME=strealtimelakehousedev
ADLS_ACCOUNT_KEY=x
FLINK_WORKLOAD_IDENTITY_CLIENT_ID=x
POLARIS_CLIENT_ID=x
POLARIS_CLIENT_SECRET=x
ACR_LOGIN_SERVER=acrrealtimelakehousedev.azurecr.io
# Must match the tag pushed by flink-jobs/sql-runner/build-and-push.sh. A
# mutable tag like :latest is cached by the nodes (imagePullPolicy
# IfNotPresent), so a rebuilt image is silently ignored.
SQL_RUNNER_TAG=x
LOW_STOCK_THRESHOLD=10
