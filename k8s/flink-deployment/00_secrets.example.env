# Copy to 00_secrets.env (gitignored) and fill in real values before running
# 01_render-and-deploy.sh. These are the ${VAR} placeholders referenced in
# flink-jobs/inventory-monitor/*.sql and 02_flinkdeployment.yaml.
#
# EVENTHUBS_*, ADLS_ACCOUNT_* come from `terraform output` in
# terraform/env/dev (e.g. `terraform output -raw adls_account_key`).
# POLARIS_CLIENT_ID/POLARIS_CLIENT_SECRET must be the same values used in
# k8s/polaris/01_secret.yaml's POLARIS_BOOTSTRAP_CREDENTIALS -- Flink
# authenticates to Polaris as the same principal Polaris was bootstrapped
# with.
EVENTHUBS_BOOTSTRAP_SERVERS=evh-realtime-lakehouse-dev.servicebus.windows.net:9093
EVENTHUBS_CONNECTION_STRING=x
ADLS_ACCOUNT_NAME=strealtimelakehousedev
ADLS_ACCOUNT_KEY=x
POLARIS_CLIENT_ID=x
POLARIS_CLIENT_SECRET=x
ACR_LOGIN_SERVER=acrrealtimelakehousedev.azurecr.io
LOW_STOCK_THRESHOLD=10
